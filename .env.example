# Copy to .env in the directory where you start CodeY. Save as UTF-8.
# Addresses and model names are format examples, not real provider settings.
# Process environment overrides .env. --profile overrides the active selection.
CODEY_PROFILE_NAMES=deepseek,qwen,gateway,local
CODEY_ACTIVE_PROFILE=deepseek

# Only the selected profile is validated. Fill it before --check-config.
CODEY_PROFILE_DEEPSEEK_BASE_URL=https://deepseek.example.com/v1
CODEY_PROFILE_DEEPSEEK_API_KEY=YOUR_API_KEY
CODEY_PROFILE_DEEPSEEK_MODEL=YOUR_MODEL

CODEY_PROFILE_QWEN_BASE_URL=https://qwen.example.com/v1
CODEY_PROFILE_QWEN_API_KEY=YOUR_API_KEY
CODEY_PROFILE_QWEN_MODEL=YOUR_MODEL

# Third-party compatible API: its own credentials/model ID.
CODEY_PROFILE_GATEWAY_BASE_URL=https://gateway.example.com/v1
CODEY_PROFILE_GATEWAY_API_KEY=YOUR_API_KEY
CODEY_PROFILE_GATEWAY_MODEL=YOUR_MODEL

# Local compatible service; adjust address and model to your actual service.
# AUTH=none allows a missing API key. Default auth is bearer.
CODEY_PROFILE_LOCAL_BASE_URL=http://localhost:8000/v1
CODEY_PROFILE_LOCAL_MODEL=YOUR_MODEL
CODEY_PROFILE_LOCAL_AUTH=none

# Profile timeout > global timeout > 120 seconds.
CODEY_LLM_TIMEOUT_SECONDS=120
# CODEY_PROFILE_LOCAL_TIMEOUT_SECONDS=60

# Legacy format is supported when CODEY_PROFILE_NAMES is absent:
# CODEY_LLM_BASE_URL=https://api.example.com/v1
# CODEY_LLM_API_KEY=YOUR_API_KEY
# CODEY_LLM_MODEL=YOUR_MODEL
# CODEY_LLM_AUTH=bearer

# Planned Agent settings, not loaded yet.
CODEY_WORKSPACE=.
CODEY_MAX_ITERATIONS=20
