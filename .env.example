# 首次使用时复制为启动目录的 .env，保存为 UTF-8；已有配置时手工补充。
# 地址与模型名只是格式示例，需要替换成平台提供的真实信息。
# 系统环境变量覆盖文件同名字段；--profile 临时覆盖默认选择。
# 可选别名列表；新增配置时需要同时在这里登记。
CODEY_PROFILE_NAMES=deepseek,qwen,gateway,local
# 默认选中的配置别名，与下方的模型 ID 是不同概念。
CODEY_ACTIVE_PROFILE=deepseek

# 只校验当前选中的配置；BASE_URL 是基础地址，不含 /chat/completions。
# API_KEY 是平台密钥；MODEL 支持一个或多个模型 ID，以英文逗号分隔。
# 同一 Profile 下模型共用地址、密钥、认证与超时；第一个模型是省略 ID 时的选择。
# 例：CODEY_PROFILE_QWEN_MODEL=qwen-model-a,qwen-model-b
# 切换：/model qwen qwen-model-b；旧命令 /model qwen 仍可使用。
CODEY_PROFILE_DEEPSEEK_BASE_URL=https://deepseek.example.com/v1
CODEY_PROFILE_DEEPSEEK_API_KEY=YOUR_API_KEY
CODEY_PROFILE_DEEPSEEK_MODEL=YOUR_MODEL

CODEY_PROFILE_QWEN_BASE_URL=https://qwen.example.com/v1
CODEY_PROFILE_QWEN_API_KEY=YOUR_API_KEY
CODEY_PROFILE_QWEN_MODEL=YOUR_MODEL

# 第三方兼容服务：填写该平台自己的地址、密钥和模型 ID。
CODEY_PROFILE_GATEWAY_BASE_URL=https://gateway.example.com/v1
CODEY_PROFILE_GATEWAY_API_KEY=YOUR_API_KEY
CODEY_PROFILE_GATEWAY_MODEL=YOUR_MODEL

# 本地兼容服务：按实际监听地址和已部署的模型填写。
# AUTH=none 不发送认证头且允许缺少密钥；其他配置默认 bearer。
CODEY_PROFILE_LOCAL_BASE_URL=http://localhost:8000/v1
CODEY_PROFILE_LOCAL_MODEL=YOUR_MODEL
CODEY_PROFILE_LOCAL_AUTH=none

# 超时单位为秒：单 Profile 配置优先，其次公共值，最后默认 120。
CODEY_LLM_TIMEOUT_SECONDS=120
# CODEY_PROFILE_LOCAL_TIMEOUT_SECONDS=60

# 没有 CODEY_PROFILE_NAMES 时兼容旧格式，别名自动为 default：
# CODEY_LLM_BASE_URL=https://api.example.com/v1
# CODEY_LLM_API_KEY=YOUR_API_KEY
# CODEY_LLM_MODEL=YOUR_MODEL
# CODEY_LLM_AUTH=bearer

# 会话配置：工作区只作为新建时的建议选项，不自动绑定历史。
CODEY_WORKSPACE=.
# 会话默认保存在 Java user.home 下的 .codey，可指定其他数据目录。
# CODEY_DATA_DIR=E:/codey-data
# 首轮后额外请求模型生成标题（最多等待 5 秒）；false 使用首问本地摘要。
CODEY_AUTO_TITLE=true

# Agent 启动配置；每条用户任务独立计算，包含最后一次仅回答的请求，范围 1–100。
CODEY_MAX_ITERATIONS=20
# list_files 省略 maxDepth 时使用的默认深度，范围 1–20；修改后重启 CodeY。
CODEY_LIST_FILES_DEFAULT_DEPTH=10
